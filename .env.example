APP_NAME="ConveyThis File Vault"
APP_ENV=local
APP_PORT=8080
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=33060
DB_FORWARD_PORT=33060
DB_DATABASE=file_vault
DB_USERNAME=file_vault
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file

DOCUMENT_DISK=documents
DOCUMENT_MAX_SIZE_MB=10
DOCUMENT_RETENTION_HOURS=24
DOCUMENT_NOTIFICATION_EMAIL=notifications@example.com

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15675
RABBITMQ_USER=file_vault
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=file.events
RABBITMQ_QUEUE=email.notifications
RABBITMQ_ROUTING_KEY=file.deleted
RABBITMQ_HEARTBEAT=30

VITE_APP_NAME="${APP_NAME}"
